#!/bin/sh
# ============================================================
# Comink — hook pre-commit chặn bí mật lọt vào Git
# ============================================================
# Mục đích: chặn commit vô tình chứa khoá API, mật khẩu, private key.
# Kết quả rà soát rủi ro bảo mật ở Giai đoạn 0 (docs/tasks/phase0_remediation.md).
#
# CÀI ĐẶT (mỗi lập trình viên chạy một lần sau khi clone):
#     git config core.hooksPath .githooks
#     chmod +x .githooks/pre-commit      (macOS/Linux)
#
# Bỏ qua khi thật cần (chỉ khi đã tự kiểm tra bằng mắt):
#     git commit --no-verify
#
# GIỚI HẠN ĐÃ BIẾT (nói rõ để không tin nhầm công cụ):
#   Hook chỉ chặn các dạng dễ nhận biết. Nó KHÔNG thay thế việc tự rà soát:
#   một mật khẩu tuỳ ý gán cho một biến không có từ khoá gợi ý sẽ lọt qua.
#   Mọi khoá thật vẫn phải nằm trong `.env` (đã gitignore) hoặc user-secrets.
#
# GHI CHÚ KỸ THUẬT (để lần sau sửa không lặp lại lỗi):
#   1. Không dùng lookahead `(?=...)`: `grep -E` của Git không hỗ trợ nên mẫu sẽ
#      im lặng không khớp và hook mất tác dụng.
#   2. `grep` khớp theo TỪNG DÒNG: nếu một dòng vừa có giá trị vô hại vừa có bí mật,
#      việc "cho phép theo dòng" sẽ bỏ lọt bí mật. Vì vậy các mẫu ở đây cố tình
#      hẹp và không cố phân biệt "nhãn i18n" với "giá trị thật".
# ============================================================

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$ROOT" || exit 0

# File mẫu và tài liệu được phép chứa chuỗi ví dụ
SKIP_FILES='^\.env\.example$|\.md$|\.example$|^docs/'

# File bị cấm commit hoàn toàn (mẫu `.env.example` được SKIP_FILES bỏ qua trước)
BLOCKED_FILES='(^|/)\.env(\.[A-Za-z0-9_-]+)?$|service-?[Aa]ccount.*\.json$|(^|/)appsettings\.(Local|[A-Za-z0-9_-]+\.local)\.json$|\.(jks|keystore|p12|pfx|pem)$'

# Mẫu nội dung có độ tin cậy cao (không dùng lookahead)
PATTERNS='BEGIN [A-Z ]*PRIVATE KEY
AKIA[0-9A-Z]{16}
sk-[A-Za-z0-9_-]{20,}
AIza[0-9A-Za-z_-]{35}
xox[baprs]-[0-9A-Za-z-]{10,}
gh[pousr]_[A-Za-z0-9]{36,}
[Pp]assword[[:space:]]*=[[:space:]]*[^;[:space:]"]{6,}
[Aa]pi[_-]?[Kk]ey[[:space:]]*=[[:space:]]*[A-Za-z0-9/+=_-]{20,}'

# Chuỗi dev/placeholder đã biết là vô hại.
#
# Dùng ranh giới từ `(^|[^a-z0-9])...( |$)` thay vì khớp chuỗi con:
#  - `"password": "Password"` trong file dịch i18n phải được cho qua;
#  - nhưng `Password=YourPassword123` phải bị chặn — nếu dùng allowlist thô,
#    chuỗi con `your_` sẽ che mất mật khẩu thật (đã từng xảy ra).
ALLOWLIST='(^|[^a-z0-9])(change_me|your_|placeholder|dummy|CHANGE_ME|devpassword|devredispass|devkey|devsecret|dev_only_|firebase-adminsdk-xxxx|Admin@123456!|not-for-production|YOUR_KEY_HERE|Password|password|passwd|secret|token)([^a-z0-9]|$)'

STATUS=0
TMP=$(mktemp) || TMP="/tmp/comink-precommit-$$"
trap 'rm -f "$TMP"' EXIT

# ------------------------------------------------------------
# 1. Chặn các file không bao giờ được commit
# ------------------------------------------------------------
for f in $(git diff --cached --name-only --diff-filter=ACMR); do
  case "$f" in
    *.md|.env.example|*.example)
      continue
      ;;
  esac

  if printf '%s' "$f" | grep -Eq "$BLOCKED_FILES"; then
    echo "[pre-commit] CHẶN: file bị cấm commit: $f" >&2
    STATUS=1
  fi
done

# ------------------------------------------------------------
# 2. Quét nội dung các dòng mới thêm
# ------------------------------------------------------------
for f in $(git diff --cached --name-only --diff-filter=ACMR); do
  if printf '%s' "$f" | grep -Eq "$SKIP_FILES"; then
    continue
  fi

  # Chỉ lấy dòng được THÊM vào, bỏ phần header và dòng bị xoá.
  git diff --cached -U0 --no-color -- "$f" 2>/dev/null \
    | grep -E '^\+' | grep -vE '^\+\+\+' > "$TMP" || true
  [ -s "$TMP" ] || continue

  # Dùng here-document để vòng lặp chạy trong shell hiện tại
  # (nếu dùng pipe, `exit 1` chỉ thoát subshell và mất mã thoát).
  while IFS= read -r pattern; do
    [ -z "$pattern" ] && continue

    hits=$(grep -nE -- "$pattern" "$TMP" 2>/dev/null | grep -viE -- "$ALLOWLIST" || true)
    if [ -n "$hits" ]; then
      echo "" >&2
      echo "[pre-commit] CẢNH BÁO: $f có thể chứa bí mật (mẫu: $pattern)" >&2
      printf '%s\n' "$hits" | sed 's/^/    /' >&2
      echo "    -> Nếu là giá trị mẫu thật: thay bằng placeholder hoặc đưa vào .env / user-secrets" >&2
      echo "    -> Nếu chắc chắn không phải bí mật: git commit --no-verify" >&2
      STATUS=1
    fi
  done <<PATTERNS_LIST
$PATTERNS
PATTERNS_LIST
done

if [ "$STATUS" -ne 0 ]; then
  echo "" >&2
  echo "[pre-commit] Commit bị huỷ. Xem hướng dẫn ở trên." >&2
  exit 1
fi

echo "[pre-commit] OK: không phát hiện bí mật."
exit 0
