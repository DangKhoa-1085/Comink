# ============================================================
# COMINK — Biến môi trường mẫu
# ============================================================
# Cách dùng:
#   cp .env.example .env      (rồi điền giá trị thật; KHÔNG commit file .env)
#
# File này phục vụ HAI cơ chế, mỗi cơ chế đọc một phần khác nhau:
#
#   1. Docker Compose (infra/docker-compose.yml) đọc các biến HẠ TẦNG:
#      POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB, REDIS_PASSWORD
#      → Compose đọc file .env ở thư mục đang đứng khi chạy lệnh.
#
#   2. Backend ASP.NET Core đọc các biến cấu hình theo quy ước của .NET:
#      dấu hai gạch dưới "__" tương ứng dấu ":" trong cấu hình.
#      Ví dụ: ConnectionStrings__Postgres  ->  ConnectionStrings:Postgres
#      Program.cs nạp file .env khi khởi động (thư viện DotNetEnv).
#
# Thứ tự ưu tiên (cao hơn thì thắng):
#      biến môi trường của hệ điều hành  >  user-secrets  >  file .env  >  appsettings.Development.json
#      => Biến đã có sẵn trong môi trường KHÔNG bị file .env ghi đè.
#      => Nếu một khoá có mặt trong appsettings.Development.json, giá trị ở đó
#         sẽ thắng file .env; vì vậy bí mật không được đặt trong appsettings.
#
# LƯU Ý về cú pháp: giá trị có khoảng trắng hoặc dấu chấm phẩy nên đặt trong dấu
# ngoặc kép (ví dụ Push__PrivateKey bên dưới).
# ============================================================

# --- Cấu hình chung của ứng dụng ---
ASPNETCORE_ENVIRONMENT=Development
FrontendUrl=http://localhost:5173

# --- Hạ tầng: Docker Compose đọc các biến này ---
POSTGRES_USER=comink
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=comink

REDIS_PASSWORD=change_me_redis_password

# --- Chuỗi kết nối cho backend (.NET) ---
# Mật khẩu phải khớp POSTGRES_PASSWORD / REDIS_PASSWORD ở trên.
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=comink;Username=comink;Password=change_me_strong_password
ConnectionStrings__Redis=localhost:6379,password=change_me_redis_password

# --- JWT ---
# Bắt buộc dài tối thiểu 32 ký tự. Sinh chuỗi ngẫu nhiên, không dùng giá trị mẫu.
Jwt__Issuer=comink-api
Jwt__Audience=comink-clients
Jwt__Secret=change_me_at_least_32_chars_long_secret_key_here
Jwt__AccessTokenExpiryMinutes=15
Jwt__RefreshTokenExpiryDays=30

# --- LiveKit ---
# LiveKit yêu cầu API secret dài tối thiểu 32 ký tự; secret ngắn hơn làm container
# livekit thoát ngay khi khởi động. Giá trị này phải khớp với infra/livekit.yaml
# (khối `keys`) và appsettings.Development.json (mục `LiveKit`).
LiveKit__Host=http://localhost:7880
LiveKit__ApiKey=devkey
LiveKit__ApiSecret=SyIgXn46XZgezLiVzrNjWBbIdwBgIkGSZuSt4k0AlRBvWkoM

# --- Tài khoản admin đầu tiên (seed) ---
# Chỉ dùng ở môi trường Development. Để trống AdminSeed__Password thì bỏ qua seed.
# Khuyến nghị: đặt mật khẩu bằng user-secrets thay vì file này.
AdminSeed__Email=admin@comink.local
AdminSeed__Password=
AdminSeed__DisplayName=Administrator

# --- Cloudinary (Giai đoạn 2) ---
MediaStorage__CloudName=your_cloud_name
MediaStorage__ApiKey=your_api_key
MediaStorage__ApiSecret=your_api_secret

# --- Email: Mailpit khi dev, Resend khi production (Giai đoạn 1 NC) ---
Email__Host=localhost
Email__Port=1025
Email__Username=
Email__Password=
Email__From=noreply@comink.local
# Production:
# Email__Host=smtp.resend.com
# Email__Username=resend
# Email__Password=re_xxxxxxxxxxxxxxxxxxxx

# --- Firebase Cloud Messaging — push notification (Giai đoạn 6) ---
Push__ProjectId=your_firebase_project_id
Push__PrivateKeyId=your_private_key_id
Push__PrivateKey="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----"
Push__ClientEmail=firebase-adminsdk-xxxx@your-project.iam.gserviceaccount.com

# --- AI: Google Gemini (làm sau cùng) ---
Ai__Provider=Gemini
Ai__ApiKey=your_gemini_api_key
Ai__Model=gemini-2.0-flash-lite
