# ============================================================
# COMINK — Biến môi trường mẫu
# Sao chép thành .env rồi điền giá trị thật (không commit .env!)
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=comink
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=comink

# --- Redis ---
REDIS_PASSWORD=change_me_redis_password

# --- JWT ---
JWT_SECRET=change_me_at_least_32_chars_long_secret_key_here
JWT_ISSUER=comink-api
JWT_AUDIENCE=comink-clients
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRY_DAYS=30

# --- LiveKit ---
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
LIVEKIT_HOST=http://localhost:7880

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Email (Mailpit cho dev, Resend cho production) ---
# Dev: SMTP của Mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@comink.local

# Production: Resend
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# SMTP_FROM=noreply@yourdomain.com

# --- Firebase Cloud Messaging (Push Notification) ---
FCM_PROJECT_ID=your_firebase_project_id
FCM_PRIVATE_KEY_ID=your_private_key_id
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----"
FCM_CLIENT_EMAIL=firebase-adminsdk-xxxx@your-project.iam.gserviceaccount.com

# --- Gemini AI ---
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash-lite

# --- App ---
ASPNETCORE_ENVIRONMENT=Development
FRONTEND_URL=http://localhost:5173

# --- Admin seed (tài khoản admin đầu tiên) ---
ADMIN_EMAIL=admin@comink.local
ADMIN_PASSWORD=Admin@123456!
ADMIN_DISPLAY_NAME=Administrator
